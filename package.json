{
  "name": "dsh-big-coming",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: probes the official model system fingerprint on a timer with a minimal request, and pops a random meme when it changes.",
  "icon": "assets/icon-180.png",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "memes/*.jpg",
    "sounds/*.mp3",
    "assets",
    "screenshots.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sumcam-L/dsh-big-coming.git"
  },
  "homepage": "https://github.com/Sumcam-L/dsh-big-coming#readme",
  "bugs": {
    "url": "https://github.com/Sumcam-L/dsh-big-coming/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "fingerprint",
    "system-fingerprint",
    "meme",
    "fun",
    "entertainment"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
